[Unit]
Description=Private device authentication for Hysteria
After=network.target
Before=hysteria-server.service

[Service]
Type=simple
User=hy2admin
Group=hy2admin
WorkingDirectory=/opt/hy2-admin
EnvironmentFile=/etc/hy2-admin.env
ExecStart=/opt/hy2-admin/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8788 --access-logfile /dev/null auth_service:create_auth_app()
Restart=on-failure
RestartSec=2
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hy2-admin
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
